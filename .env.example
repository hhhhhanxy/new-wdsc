# 环境配置模板文件
# 复制此文件为 .env 并填入实际值

# 环境配置 (dev/prod/test)
ENVIRONMENT=dev
MODEL_CONFIG_PATH=config/model_service.json

# ================================
# 模型服务配置
# ================================
# 推荐将模型名称、URL、API Key 等统一写入 config/model_service.json
# 下列变量保留为兼容兜底；若 model_service.json 已配置，可不再填写
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER=

# ================================
# LLM 参数
# ================================
MAX_TOKENS=4096
TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_CONNECT_TIMEOUT=30
# true 表示读取 HTTP_PROXY/HTTPS_PROXY 等系统代理；代理不稳定时可改为 false
LLM_TRUST_ENV=true

# ================================
# 文档处理配置
# ================================
DEFAULT_DOCUMENT_PATH=document.docx
CHUNK_SIZE=1000

# ================================
# 本地 Web 服务与数据目录
# ================================
# 默认仅本机访问；内网其他机器访问可改为 0.0.0.0，并在服务器防火墙放行端口
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_THREADS=8
# uv 缓存建议固定在项目目录，便于内网环境迁移和权限控制
UV_CACHE_DIR=D:\code\new-wdsc\.uv-cache
# 上传模板、生成文件默认保存在 uploads/ 下；SQLite 默认 web/database.db
UPLOAD_FOLDER=uploads
DATABASE_PATH=web/database.db

# ================================
# 日志配置
# ================================
LOG_LEVEL=INFO

# ================================
# 缓存配置
# ================================
CACHE_ENABLED=true
CACHE_TTL=3600

# ================================
# 重试配置
# ================================
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT=2
RETRY_MAX_WAIT=10
