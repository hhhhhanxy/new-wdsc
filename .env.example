# 环境配置模板文件
# 复制此文件为 .env 并填入实际值

# 环境配置 (dev/prod/test)
ENVIRONMENT=dev

# ================================
# LLM API 配置
# ================================
# LLM API Key (必填)
LLM_API_KEY=sk-your-api-key-here

# LLM API 地址
LLM_BASE_URL=https://api.siliconflow.cn/v1

# LLM 模型名称
LLM_MODEL=deepseek-ai/DeepSeek-V3.2

# LLM 提供商
LLM_PROVIDER=siliconflow

# ================================
# LLM 参数
# ================================
MAX_TOKENS=4096
TEMPERATURE=0.1

# ================================
# 文档处理配置
# ================================
DEFAULT_DOCUMENT_PATH=document.docx
CHUNK_SIZE=1000

# ================================
# 日志配置
# ================================
LOG_LEVEL=INFO

# ================================
# 缓存配置
# ================================
CACHE_ENABLED=true
CACHE_TTL=3600

# ================================
# 重试配置
# ================================
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT=2
RETRY_MAX_WAIT=10
