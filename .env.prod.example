# 生产环境配置模板
# 复制此文件为 .env.prod 并填入实际值

# 环境配置
ENVIRONMENT=prod

# ================================
# LLM API 配置
# ================================
# 生产环境 API Key (必填，使用生产环境的 Key)
LLM_API_KEY=sk-your-prod-api-key-here

# LLM API 地址
LLM_BASE_URL=https://api.siliconflow.cn/v1

# LLM 模型名称
LLM_MODEL=deepseek-ai/DeepSeek-V3.2

# LLM 提供商
LLM_PROVIDER=siliconflow

# ================================
# LLM 参数
# ================================
# 生产环境使用更大的 token 限制
MAX_TOKENS=8192

# 生产环境使用更低的温度以获得更稳定的输出
TEMPERATURE=0.1

# ================================
# 文档处理配置
# ================================
DEFAULT_DOCUMENT_PATH=documents/document.docx
CHUNK_SIZE=1000

# ================================
# 日志配置
# ================================
# 生产环境只记录警告和错误
LOG_LEVEL=WARNING

# ================================
# 缓存配置
# ================================
# 生产环境启用缓存以提高性能
CACHE_ENABLED=true

# 缓存过期时间 (2小时)
CACHE_TTL=7200

# ================================
# 重试配置
# ================================
# 生产环境启用重试以提高可靠性
RETRY_ENABLED=true

# 最大重试次数
RETRY_MAX_ATTEMPTS=5

# 最小重试等待时间 (秒)
RETRY_MIN_WAIT=2

# 最大重试等待时间 (秒)
RETRY_MAX_WAIT=30
