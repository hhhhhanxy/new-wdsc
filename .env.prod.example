# 生产环境配置模板
# 复制此文件为 .env.prod 并填入实际值

# 环境配置
ENVIRONMENT=prod
MODEL_CONFIG_PATH=config/model_service.json

# ================================
# 模型服务配置
# ================================
# 推荐将模型名称、URL、API Key 等统一写入 config/model_service.json
# 下列变量保留为兼容兜底；若 model_service.json 已配置，可不再填写
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER=

# ================================
# LLM 参数
# ================================
# 生产环境使用更大的 token 限制
MAX_TOKENS=8192

# 生产环境使用更低的温度以获得更稳定的输出
TEMPERATURE=0.1

# LLM 请求超时配置
LLM_TIMEOUT=120
LLM_CONNECT_TIMEOUT=30
# true 表示读取 HTTP_PROXY/HTTPS_PROXY 等系统代理；代理不稳定时可改为 false
LLM_TRUST_ENV=true

# ================================
# 文档处理配置
# ================================
DEFAULT_DOCUMENT_PATH=documents/document.docx
CHUNK_SIZE=1000

# ================================
# 本地 Web 服务与数据目录
# ================================
# 对外提供内网访问时可设置为 0.0.0.0，并在服务器防火墙放行端口
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_THREADS=8
UV_CACHE_DIR=D:\apps\new-wdsc\.uv-cache
UPLOAD_FOLDER=uploads
DATABASE_PATH=web/database.db

# ================================
# 日志配置
# ================================
# 生产环境只记录警告和错误
LOG_LEVEL=WARNING

# ================================
# 缓存配置
# ================================
# 生产环境启用缓存以提高性能
CACHE_ENABLED=true

# 缓存过期时间 (2小时)
CACHE_TTL=7200

# ================================
# 重试配置
# ================================
# 生产环境启用重试以提高可靠性
RETRY_ENABLED=true

# 最大重试次数
RETRY_MAX_ATTEMPTS=5

# 最小重试等待时间 (秒)
RETRY_MIN_WAIT=2

# 最大重试等待时间 (秒)
RETRY_MAX_WAIT=30
