    "created": {
      "rule_rd_101": {
        "source": "requir_doc1",
        "name": "功能需求完整性检查",
        "description": "检查主要功能需求是否形成可理解、可实现的完整描述。",
        "category": "custom",
        "severity": "error",
        "review_type": "llm",
        "enabled": true,
        "code": "RD-101",
        "logic": "定位“功能需求”“功能要求”或同类章节。每项主要功能需求应明确描述触发条件、处理过程或功能行为以及预期输出；三项内容均明确时通过。若仅描述功能名称、缺少输入条件、处理逻辑或输出结果，应指出具体缺失内容和所在章节，不得自行补造需求。",
        "standard_ref": "",
        "aliases": [
          "RD-101",
          "功能需求完整性检查"
        ],
        "params": {},
        "scope": "body",
        "target_headings": [
          "功能需求",
          "功能要求",
          "功能描述"
        ],
        "required_elements": [
          "触发条件",
          "功能行为",
          "预期输出"
        ]
      },
      "rule_rd_102": {
        "source": "requir_doc1",
        "name": "技术指标可验证性检查",
        "description": "检查需求是否量化、可判定并具备后续验证条件。",
        "category": "custom",
        "severity": "error",
        "review_type": "llm",
        "enabled": true,
        "code": "RD-102",
        "logic": "检查性能指标、技术指标及约束条件。指标应尽量包含明确的对象、量值或范围、单位以及适用条件，并能够通过试验、分析、检查或演示等方式验证。指标完整且可判定时通过；存在“性能良好”“响应迅速”“满足使用要求”等模糊表述，或缺少必要量值、单位、边界条件时，应指出原文及缺失项。模板明确要求待定的内容可标记为“待补充”，不得推断数值。",
        "standard_ref": "",
        "aliases": [
          "RD-102",
          "技术指标可验证性检查"
        ],
        "params": {},
        "scope": "body",
        "target_headings": [
          "性能要求",
          "技术指标",
          "环境要求",
          "可靠性要求"
        ],
        "required_elements": [
          "指标对象",
          "量值或范围",
          "单位",
          "适用条件",
          "验证方式"
        ]
      }
    },
    "updated": {}
  },
